# Realbites - Environment Configuration Template
# Copy this file to .env and insert your Google AI Studio API key.
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey

# Required: Google Gemini / Gemma API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI model
# Recommended Gemma 4 models: gemma-4-26b-a4b-it or gemma-4-31b-it
# Verified Gemini fallback: gemini-2.5-flash or gemini-1.5-flash
DEFAULT_MODEL=gemma-4-26b-a4b-it
